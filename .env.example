# Copy to .env (gitignored) for local `vercel dev`, and set the same names as Vercel
# environment variables for production. See
# specs/002-database-simplification/contracts/turso-token-endpoint.md.

# Turso Platform API admin token, scoped to this project's environments only.
TURSO_PLATFORM_TOKEN=

# Turso organization slug (e.g. "victorvaquero").
TURSO_ORG_SLUG=

# Production database.
TURSO_DATABASE_NAME=
TURSO_DATABASE_URL=

# Guest/demo database (never contains real financial data).
TURSO_GUEST_DATABASE_NAME=
TURSO_GUEST_DATABASE_URL=

# Real user's GnuCash account-GUID mapping (server-only — never committed, never sent to
# the client bundle), returned only to Cognito users who are members of the "owners"
# group in the user pool (api/turso-token.ts) — every other authenticated user (e.g. a
# CI/Playwright test account) gets guest-equivalent demo data instead. JSON-encoded
# object matching the `AccountConfig` shape documented in
# specs/005-repo-hygiene-security-and-public-readiness/data-model.md entity 2 and
# specs/005-repo-hygiene-security-and-public-readiness/contracts/turso-token-endpoint-amendment.md.
# Example shape (values are this user's real GnuCash account GUIDs — do not commit real
# values here):
# ACCOUNT_CONFIG_VICTOR={"expenses":"...","income":"...","checking":"...","savings":"...","assets":"...","working":"...","liability":"...","investments":"...","taxes":"...","taxesAll":["..."],"tripDesc":"..."}
ACCOUNT_CONFIG_VICTOR=
