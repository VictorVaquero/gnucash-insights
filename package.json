{
  "name": "cashpy_v2",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "dev:api": "bash scripts/dev-with-api.sh",
    "mint-turso-token": "bash scripts/mint-turso-token.sh",
    "test-auth-boundary": "node scripts/test-auth-boundary.mjs",
    "check-csp-drift": "node scripts/check-csp-drift.mjs",
    "build": "vite build && tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "perf": "lhci autorun",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip"
  },
  "size-limit": [
    {
      "name": "main bundle",
      "path": "dist/dashboard/assets/main-*.js",
      "gzip": true,
      "limit": "350 KB"
    },
    {
      "name": "chart route chunk",
      "path": "dist/dashboard/assets/CartesianChart-*.js",
      "gzip": true,
      "limit": "89 KB"
    }
  ],
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1105.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@libsql/client": "^0.17.4",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.22",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/router-plugin": "^1.168.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^0.555.0",
    "luxon": "^3.5.0",
    "motion": "^11.18.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^5.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@chromatic-com/storybook": "^3.2.4",
    "@eslint/js": "^9.20.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@recharts/devtools": "^0.0.16",
    "@size-limit/file": "^13.0.3",
    "@storybook/addon-essentials": "^8.5.3",
    "@storybook/addon-interactions": "^8.5.3",
    "@storybook/addon-onboarding": "^8.5.3",
    "@storybook/react": "^8.5.3",
    "@storybook/react-vite": "^8.5.3",
    "@storybook/test": "^8.6.15",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3": "^7.4.3",
    "@types/luxon": "^3.7.3",
    "@types/node": "^20.17.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^5.9.6",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^0.11.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.1",
    "lint-staged": "^15.5.2",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.4",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "storybook": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vercel": "^58.8.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.5.7",
      "seroval": ">=1.5.3",
      "tar": ">=7.5.19"
    }
  }
}
